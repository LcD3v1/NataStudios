    "next": "^15.3.0",
    "next-intl": "^4.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "resend": "^4.0.0",
    "sharp": "^0.35.3",
    "zod": "^3.24.0",
    "prisma": "^6.2.0"
  },
  "overrides": {
    "sharp": "^0.35.3",
    "postcss": "^8.5.18"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
