# ─────────────────────────────────────────────────────────────
#  NATA STUDIOS — environment variables
#  Copy to `.env.local` (Next.js) and/or `.env` (Prisma CLI).
#  NEVER commit the filled-in files. They are already in .gitignore.
# ─────────────────────────────────────────────────────────────

# --- Database (read by Prisma CLI + app) — put in `.env` ---
# Local dev: SQLite file. Production: a managed Postgres URL (Supabase/RDS) with
# a LEAST-PRIVILEGE user and SSL, e.g. postgresql://app:***@host:5432/db?sslmode=require
DATABASE_URL="file:./dev.db"

# --- Auth session secret (JWT signing) — put in `.env` ---
# MUST be >= 32 chars and unique per environment. Generate with:
#   openssl rand -base64 48
AUTH_SECRET="change-me-generate-a-long-random-secret-min-32-chars"

# --- Email (Resend) — put in `.env.local` ---
# Create a key at https://resend.com/api-keys
RESEND_API_KEY=
CONTACT_TO_EMAIL=contato@natastudios.com
# Production: verify your domain in Resend and use no-reply@natastudios.com
RESEND_FROM=NATA STUDIOS <onboarding@resend.dev>

# --- Public site URL (used for OG/social images) ---
# Production example: https://natastudios.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Optional: initial admin seed (used by `npm run db:seed`) ---
SEED_ADMIN_EMAIL=admin@natastudios.com
SEED_ADMIN_PASSWORD=change-this-strong-password
